{
  "schemaVersion": 1,
  "id": "nova-launch",
  "sourceUrl": "https://nova.example.com",
  "fps": 30,
  "durationSeconds": 20,
  "brand": {
    "name": "Nova",
    "colors": {
      "background": "#0B1020",
      "foreground": "#F4F6FB",
      "primary": "#7C9CFF",
      "accent": "#FFB86B",
      "muted": "#8A93A8"
    },
    "fonts": {
      "display": { "family": "Sora", "source": "font-display" },
      "body": { "family": "Inter", "source": "font-body" }
    },
    "logoAssetId": "logo",
    "radius": 12
  },
  "assets": {
    "logo": {
      "kind": "svg",
      "src": "assets/nova/logo.svg",
      "provenance": "captured",
      "sourceUrl": "https://nova.example.com"
    },
    "dashboard-shot": {
      "kind": "image",
      "src": "assets/nova/dashboard.png",
      "provenance": "captured",
      "width": 2880,
      "height": 1800,
      "sourceUrl": "https://nova.example.com/product"
    },
    "font-display": {
      "kind": "font",
      "src": "assets/fonts/sora.woff2",
      "provenance": "library",
      "license": "OFL-1.1"
    },
    "font-body": {
      "kind": "font",
      "src": "assets/fonts/inter.woff2",
      "provenance": "library",
      "license": "OFL-1.1"
    },
    "music-bed": {
      "kind": "audio",
      "src": "assets/audio/bed.mp3",
      "provenance": "stock",
      "license": "Example Stock Audio License"
    },
    "whoosh": {
      "kind": "audio",
      "src": "assets/audio/whoosh.mp3",
      "provenance": "library"
    }
  },
  "claims": [
    {
      "id": "build-times",
      "text": "Nova cuts build times by 40%",
      "sourceUrl": "https://nova.example.com/customers",
      "quote": "Teams on Nova cut build times by 40% in their first month.",
      "status": "approved"
    },
    {
      "id": "team-count",
      "text": "Over 1,200 teams use Nova",
      "sourceUrl": "https://nova.example.com",
      "quote": "More than 1,200 teams ship with Nova every week.",
      "status": "approved"
    },
    {
      "id": "deploy-rate",
      "text": "Customers deploy 3x more often",
      "sourceUrl": "https://nova.example.com/customers",
      "quote": "Customers deploy 3x more often after switching to Nova.",
      "status": "approved"
    },
    {
      "id": "pricing",
      "text": "Plans start at $29 per seat",
      "sourceUrl": "https://nova.example.com/pricing",
      "quote": "Plans start at $29 per seat, per month.",
      "status": "extracted"
    }
  ],
  "scenes": [
    {
      "id": "open",
      "type": "kinetic-title",
      "start": 0,
      "end": 4,
      "props": { "align": "center" },
      "text": [
        {
          "id": "open-headline",
          "role": "headline",
          "value": "Your builds are waiting.",
          "claimIds": []
        },
        {
          "id": "open-subhead",
          "role": "subhead",
          "value": "Nova gets them moving.",
          "claimIds": []
        }
      ],
      "voiceover": { "text": "Your builds are waiting. Nova gets them moving.", "claimIds": [] },
      "assetIds": ["logo"],
      "transitionOut": "push"
    },
    {
      "id": "speed",
      "type": "interface-reveal",
      "start": 4,
      "end": 9,
      "props": { "focus": { "x": 0.8, "y": 0.4 }, "zoom": 1.6 },
      "text": [
        {
          "id": "speed-headline",
          "role": "headline",
          "value": "40% faster builds",
          "claimIds": ["build-times"]
        },
        {
          "id": "speed-label",
          "role": "label",
          "value": "in the first month",
          "claimIds": ["build-times"]
        }
      ],
      "voiceover": {
        "text": "Teams on Nova cut build times by 40% in their first month.",
        "claimIds": ["build-times"]
      },
      "assetIds": ["dashboard-shot"],
      "transitionOut": "carry"
    },
    {
      "id": "adoption",
      "type": "feature-sequence",
      "start": 9,
      "end": 14,
      "props": { "stops": [{ "x": 0.4, "y": 0.3, "zoom": 1.5 }] },
      "text": [
        {
          "id": "adoption-headline",
          "role": "headline",
          "value": "1,200 teams",
          "claimIds": ["team-count"]
        },
        {
          "id": "adoption-body",
          "role": "body",
          "value": "Deploying 3x more often.",
          "claimIds": ["deploy-rate"]
        }
      ],
      "voiceover": {
        "text": "More than 1,200 teams ship with Nova, and customers deploy 3x more often.",
        "claimIds": ["team-count", "deploy-rate"]
      },
      "assetIds": ["dashboard-shot"],
      "transitionOut": "carry"
    },
    {
      "id": "close",
      "type": "cta",
      "start": 14,
      "end": 20,
      "props": {},
      "text": [
        { "id": "close-headline", "role": "headline", "value": "Ship with Nova.", "claimIds": [] },
        {
          "id": "close-price",
          "role": "label",
          "value": "From $29 per seat",
          "claimIds": ["pricing"]
        },
        { "id": "close-cta", "role": "cta", "value": "Start free", "claimIds": [] }
      ],
      "voiceover": {
        "text": "Plans start at $29 per seat. Start free today.",
        "claimIds": ["pricing"]
      },
      "assetIds": ["logo"]
    }
  ],
  "audio": {
    "voice": { "provider": "elevenlabs", "voiceId": "nova-narrator" },
    "musicAssetId": "music-bed",
    "sfx": [{ "assetId": "whoosh", "at": 4 }]
  },
  "variants": {
    "hooks": [
      {
        "id": "open-question",
        "type": "kinetic-title",
        "start": 0,
        "end": 4,
        "props": { "align": "left" },
        "text": [
          {
            "id": "question-headline",
            "role": "headline",
            "value": "Still waiting on CI?",
            "claimIds": []
          }
        ],
        "voiceover": { "text": "Still waiting on CI?", "claimIds": [] },
        "assetIds": ["logo"]
      }
    ],
    "formats": ["16:9", "9:16", "1:1"],
    "ctas": [
      { "id": "start-free", "label": "Start free", "href": "https://nova.example.com/signup" },
      { "id": "book-demo", "label": "Book a demo", "href": "https://nova.example.com/demo" }
    ]
  }
}
