  "claims": [
    {
      "id": "home-subhead",
      "text": "PostHog ingests and stores your analytics, errors, replays, and business data so you and your agents can query and act on it.",
      "sourceUrl": "https://posthog.com/",
      "quote": "PostHog ingests and stores your analytics, errors, replays, and business data so you and your agents can query and act on it.",
      "status": "extracted"
    },
    {
      "id": "home-self-driving-pr",
      "text": "If you enable self-driving, when a report is ready, PostHog writes the pull request for you. You review and merge.",
      "sourceUrl": "https://posthog.com/",
      "quote": "If you enable self-driving, when a report is ready, PostHog writes the pull request for you. You review and merge.",
      "status": "extracted"
    },
    {
      "id": "session-replay-def",
      "text": "Session Replay records what happens in a user's session – clicks, scrolls, form inputs, page views, network requests, console logs – and plays it back like video.",
      "sourceUrl": "https://posthog.com/session-replay",
      "quote": "Session Replay records what happens in a user's session – clicks, scrolls, form inputs, page views, network requests, console logs – and plays it back like video.",
