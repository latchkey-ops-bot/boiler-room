{
  "name": "boiler-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "render": "cd services/render && exec ./node_modules/.bin/tsx src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}
