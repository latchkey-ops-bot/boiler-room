{
  "name": "boiler-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "agents:sync": "pnpm --filter @boiler-room/agents sync",
    "research": "pnpm --filter @boiler-room/agents research",
    "qc": "pnpm --filter @boiler-room/agents qc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}
