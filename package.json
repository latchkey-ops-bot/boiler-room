{
  "name": "boiler-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "web:dev": "pnpm --filter @boiler-room/web dev",
    "web:preview": "pnpm --filter @boiler-room/web preview",
    "web:build": "pnpm --filter @boiler-room/web build:worker",
    "web:test": "pnpm --filter @boiler-room/web test",
    "web:test:smoke": "pnpm --filter @boiler-room/web test:smoke",
    "web:smoke": "pnpm --filter @boiler-room/web smoke",
    "web:db:generate": "pnpm --filter @boiler-room/web db:generate",
    "web:db:migrate:local": "pnpm --filter @boiler-room/web db:migrate:local",
    "web:db:migrate:staging": "pnpm --filter @boiler-room/web db:migrate:staging",
    "web:db:migrate:production": "pnpm --filter @boiler-room/web db:migrate:production",
    "web:provision:staging": "pnpm --filter @boiler-room/web provision:staging",
    "web:provision:production": "pnpm --filter @boiler-room/web provision:production",
    "web:secrets:sync:staging": "pnpm --filter @boiler-room/web secrets:sync:staging",
    "web:secrets:sync:production": "pnpm --filter @boiler-room/web secrets:sync:production",
    "web:deploy:staging": "pnpm --filter @boiler-room/web deploy:staging",
    "web:deploy:production": "pnpm --filter @boiler-room/web deploy:production",
    "web:rollback:staging": "pnpm --filter @boiler-room/web rollback:staging",
    "web:rollback:production": "pnpm --filter @boiler-room/web rollback:production",
    "web:logs:staging": "pnpm --filter @boiler-room/web logs:staging",
    "web:logs:production": "pnpm --filter @boiler-room/web logs:production",
    "render": "cd services/render && exec ./node_modules/.bin/tsx src/cli.ts",
    "runner:snapshot": "cd services/film-runner && exec node scripts/build-snapshot.ts",
    "runner:e2e": "cd services/film-runner && exec node scripts/e2e-computer.ts",
    "runner:test": "pnpm --filter @boiler-room/film-runner test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}
